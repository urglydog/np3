# Sao chép thành .env.local (web) / .env (worker) và tự điền giá trị thật. KHÔNG commit file đã điền.

# --- Supabase local --- (in ra khi chạy `npm run db:start` / `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở server/worker, KHÔNG bao giờ đặt tiền tố NEXT_PUBLIC_, không bundle xuống trình duyệt
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push / VAPID --- (tạo bằng `npx web-push generate-vapid-keys --json`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Gemini --- (chỉ gọi từ server; để trống cho tới khi làm P6)
GEMINI_API_KEY=
GEMINI_MODEL=
AI_DAILY_LIMIT_PER_USER=
