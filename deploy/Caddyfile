# Caddy tự xin và gia hạn chứng chỉ HTTPS (cần domain thật trỏ về IP của VPS; Web Push và PWA bắt buộc HTTPS).
{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Service worker phải luôn tươi, không cache lâu
	@sw path /sw.js
	header @sw Cache-Control "no-cache"
}
