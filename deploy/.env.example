# Sao chép thành .env trên server (chmod 600). KHÔNG commit file .env thật. Chỉ commit file mẫu này.
APP_DOMAIN=app.example.com

# Supabase (đám mây)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # chỉ server/worker được dùng, tuyệt đối không đưa ra trình duyệt
DATABASE_URL=                       # chỉ dùng cho script nhập mẫu và sao lưu

# Web Push (tạo bằng: npx web-push generate-vapid-keys --json)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Gemini (chỉ gọi từ server)
GEMINI_API_KEY=
GEMINI_MODEL=                       # đặt tên model hiện hành, không hardcode trong mã

# Hạn mức chống lạm dụng AI
AI_DAILY_LIMIT_PER_USER=5
