# Sao chép thành apps/worker/.env và tự điền giá trị thật. KHÔNG commit file đã điền.

TIMEZONE=Asia/Ho_Chi_Minh

# --- Supabase local --- (in ra khi chạy `npm run db:start` / `npx supabase start`)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push / VAPID --- (tạo bằng `npx web-push generate-vapid-keys --json`; dùng cùng cặp khóa với apps/web)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
