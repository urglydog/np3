# Sao chép thành apps/web/.env.local và tự điền giá trị thật. KHÔNG commit file đã điền.

# --- Supabase local --- (in ra khi chạy `npm run db:start` / `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở route handler/server component, KHÔNG bao giờ đặt tiền tố NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push / VAPID --- (tạo bằng `npx web-push generate-vapid-keys --json`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Bí mật server — KHÔNG đặt tiền tố NEXT_PUBLIC_; chỉ dùng ở route handler
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Gemini --- (chỉ gọi từ route handler; để trống cho tới khi làm P6)
GEMINI_API_KEY=
GEMINI_MODEL=
AI_DAILY_LIMIT_PER_USER=
